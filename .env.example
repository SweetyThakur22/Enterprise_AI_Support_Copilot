# ─── Backend ───────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot

# Anthropic API key — obtain from https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# JWT secret — generate with: openssl rand -hex 32
SECRET_KEY=your-jwt-secret-key-here

# JWT algorithm (do not change)
ALGORITHM=HS256

# JWT token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment: development | staging | production
ENVIRONMENT=development

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Frontend ──────────────────────────────────────────────────────────────────

# FastAPI base URL (used by Vite frontend)
VITE_API_BASE_URL=http://localhost:8000

# ─── Docker Compose (prod only) ────────────────────────────────────────────────

POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot
